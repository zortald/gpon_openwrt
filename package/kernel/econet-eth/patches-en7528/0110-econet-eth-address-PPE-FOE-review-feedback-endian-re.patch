From 5a2d3449ad2d9ac330f99f32594acbaa23abae13 Mon Sep 17 00:00:00 2001
From: Emre Yavuzalp <emreyavuzalp2@gmail.com>
Date: Tue, 13 Oct 2026 10:07:03 +0300
Subject: [PATCH 110/116] econet-eth: address PPE/FOE review feedback (endian,
 register naming)

Per review on PR #13:

- en75_foe_mac_info: replace the #ifdef CONFIG_CPU_BIG_ENDIAN struct
  field reordering with plain u32 words + GENMASK/FIELD_PREP accessors.
  FIELD_PREP/FIELD_GET operate on the value, not its in-memory byte
  order, so the layout is host-endian-agnostic by construction and
  __en75_ppe_foe_commit()'s per-word cpu_to_le32 needs no counterpart
  trick in the struct declaration.

- en75_ipv4_tuple / en75_foe_ipv6: drop the dead dest_port/src_port and
  protocol/_pad union members (never read anywhere outside their own
  declaration -- grepped). They were also the one spot that *wasn't*
  endian-safe (a plain struct overlay, unlike .ports which is already
  built via explicit shifts in econet_foe.c). Keep only .ports.

- Named EN75_PPE_TUPLE_PAD for the 0xa5a5a500 sentinel instead of the
  magic number inline.

- udf_tsid: still unused (no setter), but documented the act_dp/tsid/
  channel/reserved byte layout as GENMASK macros for whoever wires it
  up next, matching the ib1/ib2 idiom already used throughout this
  header.

- timestamp: renamed to _rsv_ts with a comment -- not used by this
  hardware; aging reads ib1's BIND_TIMESTAMP bits via
  en75_ppe_timestamp() instead.

- econet_ppe.c: ppe_r32()/ppe_w32() now route through en75_rreg()/
  en75_wreg() (econet_eth.h) instead of a second local readl/writel
  wrapper, so there's one real MMIO-access implementation. Kept the
  (ppe, reg_offset) calling convention as a thin wrapper rather than
  rewriting every call site, since PPE registers are accessed by
  offset throughout this file, not through a typed regs struct.

Left __en75_ppe_foe_commit() itself untouched: entry is a tagged union
(bridge/ipv4/ipv6), so the generic per-word swap is the right shape
for a function that can't know which member is live -- that's also
why a named-field le_entry copy doesn't fit here.

Compile-tested (modules build, no warnings) against a 6.18 MIPS
big-endian target tree.
---
 econet_foe.c |  38 +++++++++----------
 econet_foe.h | 101 ++++++++++++++++++++++++---------------------------
 econet_ppe.c |   9 ++++-
 3 files changed, 72 insertions(+), 76 deletions(-)

diff --git a/econet_foe.c b/econet_foe.c
index 08c170d..434dd76 100644
--- a/econet_foe.c
+++ b/econet_foe.c
@@ -93,13 +93,8 @@ int en75_foe_entry_prepare(struct en75_foe_entry *entry, int type, int l4proto,
 	if (is_multicast_ether_addr(dest_mac))
 		val |= EN75_FOE_IB2_MULTICAST;
 
-	/* Route entries keep no L4 ports; the field is poisoned like the
-	 * vendor entry so a partial match never aliases a real port pair.
-	 * 0xa5 is an arbitrary sentinel byte (same idea as 0xdeadbeef),
-	 * repeated across all three pad bytes since only the low byte
-	 * (l4proto) is ever read back.
-	 */
-	ports_pad = 0xa5a5a500 | (l4proto & 0xff);
+	/* Route entries keep no L4 ports; see EN75_PPE_TUPLE_PAD. */
+	ports_pad = EN75_PPE_TUPLE_PAD | (l4proto & 0xff);
 	if (type == EN75_PPE_PKT_TYPE_IPV4_ROUTE)
 		entry->ipv4.orig.ports = ports_pad;
 	if (type == EN75_PPE_PKT_TYPE_IPV6_ROUTE_3T)
@@ -119,14 +114,15 @@ int en75_foe_entry_prepare(struct en75_foe_entry *entry, int type, int l4proto,
 	}
 
 	l2->dest_mac_hi = get_unaligned_be32(dest_mac);
-	l2->dest_mac_lo = get_unaligned_be16(dest_mac + 4);
+	l2->w1 = FIELD_PREP(EN75_MAC_INFO_DEST_MAC_LO,
+			    get_unaligned_be16(dest_mac + 4));
 	l2->src_mac_hi = get_unaligned_be32(src_mac);
-	l2->src_mac_lo = get_unaligned_be16(src_mac + 4);
+	l2->w2 = FIELD_PREP(EN75_MAC_INFO_SRC_MAC_LO,
+			    get_unaligned_be16(src_mac + 4));
 
-	if (type >= EN75_PPE_PKT_TYPE_IPV6_ROUTE_3T)
-		l2->etype = ETH_P_IPV6;
-	else
-		l2->etype = ETH_P_IP;
+	l2->w0 = FIELD_PREP(EN75_MAC_INFO_ETYPE,
+			    type >= EN75_PPE_PKT_TYPE_IPV6_ROUTE_3T ?
+			    ETH_P_IPV6 : ETH_P_IP);
 
 	return 0;
 }
@@ -239,14 +235,14 @@ int en75_foe_entry_set_vlan(struct en75_foe_entry *entry, int vid)
 	case 0:
 		entry->ib1 |= EN75_FOE_IB1_BIND_VLAN_TAG |
 			      FIELD_PREP(EN75_FOE_IB1_BIND_VLAN_LAYER, 1);
-		l2->vlan1 = vid;
+		l2->w0 |= FIELD_PREP(EN75_MAC_INFO_VLAN1, vid);
 		return 0;
 	case 1:
 		if (!(entry->ib1 & EN75_FOE_IB1_BIND_VLAN_TAG)) {
-			l2->vlan1 = vid;
-			l2->etype |= BIT(8);
+			l2->w0 |= FIELD_PREP(EN75_MAC_INFO_VLAN1, vid) |
+				  FIELD_PREP(EN75_MAC_INFO_ETYPE, BIT(8));
 		} else {
-			l2->vlan2 = vid;
+			l2->w1 |= FIELD_PREP(EN75_MAC_INFO_VLAN2, vid);
 			entry->ib1 += FIELD_PREP(EN75_FOE_IB1_BIND_VLAN_LAYER, 1);
 		}
 		return 0;
@@ -266,11 +262,13 @@ int en75_foe_entry_set_pppoe(struct en75_foe_entry *entry, int sid)
 	struct en75_foe_mac_info *l2 = en75_foe_entry_l2(entry);
 
 	if (!(entry->ib1 & EN75_FOE_IB1_BIND_VLAN_LAYER) ||
-	    (entry->ib1 & EN75_FOE_IB1_BIND_VLAN_TAG))
-		l2->etype = ETH_P_PPP_SES;
+	    (entry->ib1 & EN75_FOE_IB1_BIND_VLAN_TAG)) {
+		l2->w0 &= ~EN75_MAC_INFO_ETYPE;
+		l2->w0 |= FIELD_PREP(EN75_MAC_INFO_ETYPE, ETH_P_PPP_SES);
+	}
 
 	entry->ib1 |= EN75_FOE_IB1_BIND_PPPOE;
-	l2->pppoe_id = sid;
+	l2->w2 |= FIELD_PREP(EN75_MAC_INFO_PPPOE_ID, sid);
 
 	return 0;
 }
diff --git a/econet_foe.h b/econet_foe.h
index 10158ac..a6f9339 100644
--- a/econet_foe.h
+++ b/econet_foe.h
@@ -69,60 +69,49 @@ enum {
 #define EN75_FOE_IB2_PORT_AG		GENMASK(23, 18)
 #define EN75_FOE_IB2_DSCP		GENMASK(31, 24)
 
-/* Shared L2 trailer: rewritten MAC/VLAN/PPPoE header for the bound flow. */
-/*
- * __en75_ppe_foe_commit() byte-swaps each 32-bit word (cpu_to_le32). On a
- * big-endian host that swaps the two u16 halves of every two-u16 word, so
- * those pairs are declared reversed to land right in the LE table; on a
- * little-endian host cpu_to_le32 is a no-op and the natural order is correct.
+/* Shared L2 trailer: rewritten MAC/VLAN/PPPoE header for the bound flow.
+ *
+ * Each two-u16 wire pair (vlan/etype, vlan/mac-lo, pppoe/mac-lo) is kept as
+ * one plain u32 word with GENMASK/FIELD_PREP accessors instead of two named
+ * u16 struct members. That makes the layout host-endian-agnostic by
+ * construction: __en75_ppe_foe_commit() byte-swaps each 32-bit word
+ * (cpu_to_le32) on its way into the LE table, and FIELD_PREP/FIELD_GET
+ * always operate on the value, never on its in-memory byte order, so there
+ * is nothing left for a big-endian host to get wrong.
  */
-struct en75_foe_mac_info {
-#ifdef CONFIG_CPU_BIG_ENDIAN
-	u16 etype;
-	u16 vlan1;
-#else
-	u16 vlan1;
-	u16 etype;
-#endif
+#define EN75_MAC_INFO_VLAN1		GENMASK(15, 0)
+#define EN75_MAC_INFO_ETYPE		GENMASK(31, 16)
+#define EN75_MAC_INFO_VLAN2		GENMASK(15, 0)
+#define EN75_MAC_INFO_DEST_MAC_LO	GENMASK(31, 16)
+#define EN75_MAC_INFO_PPPOE_ID		GENMASK(15, 0)
+#define EN75_MAC_INFO_SRC_MAC_LO	GENMASK(31, 16)
 
+struct en75_foe_mac_info {
+	u32 w0; /* EN75_MAC_INFO_VLAN1 | EN75_MAC_INFO_ETYPE */
 	u32 dest_mac_hi;
-
-#ifdef CONFIG_CPU_BIG_ENDIAN
-	u16 dest_mac_lo;
-	u16 vlan2;
-#else
-	u16 vlan2;
-	u16 dest_mac_lo;
-#endif
-
+	u32 w1; /* EN75_MAC_INFO_VLAN2 | EN75_MAC_INFO_DEST_MAC_LO */
 	u32 src_mac_hi;
-
-#ifdef CONFIG_CPU_BIG_ENDIAN
-	u16 src_mac_lo;
-	u16 pppoe_id;
-#else
-	u16 pppoe_id;
-	u16 src_mac_lo;
-#endif
+	u32 w2; /* EN75_MAC_INFO_PPPOE_ID | EN75_MAC_INFO_SRC_MAC_LO */
 };
 
 static_assert(sizeof(struct en75_foe_mac_info) == 20,
 	       "v1 FOE mac_info must be 20 bytes");
 
+/* Poison pattern for an L4-port field the hardware never reads (route
+ * entries, bridge entries): matches the vendor entry's sentinel bytes so a
+ * partial match can never alias a real port pair. The low byte is the only
+ * one ever consulted (en75_foe_entry_hash()'s l4proto use); the other three
+ * stay 0xa5 for parity with the vendor table.
+ */
+#define EN75_PPE_TUPLE_PAD	0xa5a5a500
+
 struct en75_ipv4_tuple {
 	u32 src_ip;
 	u32 dest_ip;
-	union {
-		struct {
-			u16 dest_port;
-			u16 src_port;
-		};
-		struct {
-			u8 protocol;
-			u8 _pad[3]; /* fill with 0xa5a5a5 */
-		};
-		u32 ports;
-	};
+	u32 ports; /* HNAPT/NAPT: (src_port << 16) | dest_port, host order
+		    * before __en75_ppe_foe_commit(). Route entries carry no
+		    * ports: EN75_PPE_TUPLE_PAD | l4proto instead.
+		    */
 };
 
 /* L2 bridge offload entry. */
@@ -144,9 +133,20 @@ struct en75_foe_ipv4 {
 
 	struct en75_ipv4_tuple new;
 
-	u16 timestamp;
+	/* Per-entry timestamp: AFAIK not used by this hardware (aging instead
+	 * reads ib1's own BIND_TIMESTAMP bits via en75_ppe_timestamp()); kept
+	 * reserved to match the mainline mtk_ppe v1 layout's word count.
+	 */
+	u16 _rsv_ts;
 	u16 _rsv0[3];
 
+	/* Unused by this driver; no current setter. Byte layout per upstream
+	 * review: act_dp [7:0], tsid [15:8], channel [23:16] (useful for
+	 * traffic shaping), reserved [31:24].
+	 */
+#define EN75_FOE_UDF_ACT_DP	GENMASK(7, 0)
+#define EN75_FOE_UDF_TSID	GENMASK(15, 8)
+#define EN75_FOE_UDF_CHANNEL	GENMASK(23, 16)
 	u32 udf_tsid;
 
 	struct en75_foe_mac_info l2;
@@ -157,17 +157,10 @@ struct en75_foe_ipv6 {
 	u32 src_ip[4];
 	u32 dest_ip[4];
 
-	union {
-		struct {
-			u8 protocol;
-			u8 _pad[3]; /* fill with 0xa5a5a5 */
-		}; /* 3-tuple */
-		struct {
-			u16 dest_port;
-			u16 src_port;
-		}; /* 5-tuple */
-		u32 ports;
-	};
+	u32 ports; /* 5-tuple: (src_port << 16) | dest_port, host order before
+		    * __en75_ppe_foe_commit(). 3-tuple: EN75_PPE_TUPLE_PAD |
+		    * l4proto instead (see en75_ipv4_tuple::ports).
+		    */
 
 	u32 _rsv[3];
 
diff --git a/econet_ppe.c b/econet_ppe.c
index 4aa5e4f..e2ac7da 100644
--- a/econet_ppe.c
+++ b/econet_ppe.c
@@ -21,18 +21,23 @@
 #include <linux/if_ether.h>
 #include <linux/in.h>
 
+#include "econet_eth.h"
 #include "econet_ppe.h"
 
 #define EN75_PPE_WAIT_TIMEOUT_US	1000000
 
+/* en75_rreg()/en75_wreg() (econet_eth.h) are the one place in the driver
+ * that knows how to do a plain 32-bit MMIO access; reuse them here instead
+ * of a second, PPE-local readl/writel wrapper.
+ */
 static inline u32 ppe_r32(struct en75_ppe *ppe, u32 reg)
 {
-	return readl(ppe->base + reg);
+	return en75_rreg((u32 __iomem *)(ppe->base + reg));
 }
 
 static inline void ppe_w32(struct en75_ppe *ppe, u32 reg, u32 val)
 {
-	writel(val, ppe->base + reg);
+	en75_wreg(val, (u32 __iomem *)(ppe->base + reg));
 }
 
 static int ppe_wait_busy(struct en75_ppe *ppe)
