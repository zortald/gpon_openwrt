From 4305b2e81b1b252d1b08d8c707fed5be79ea7885 Mon Sep 17 00:00:00 2001
From: Sergey <onufriev.serg@gmail.com>
Date: Wed, 11 Nov 2026 00:25:43 +0200
Subject: [PATCH 115/116] econet-eth: GDM special tag mode and little-endian
 MAC mangle for EN7528

Behind the EN7528 built-in switch the PPE only binds flows when the GDM
runs in special tag mode (stag_en = 1), as the vendor driver configures
it. The MTK tag stays inline in both directions; the RX descriptor then
reports the source port as 8 + switch port, which belongs to GDM1.

The L2 rewrite mangle for offloaded flows was written for big-endian
EN751221. On little-endian EN7528 the flow_action encoding matches the
CPU, so use the mtk_flow_offload_mangle_eth() byte copy there.

Module parameters: en75_ppe (default on) to run without the PPE,
en75_hw_stag (default on) for the GDM special tag mode.

Signed-off-by: Sergey <onufriev.serg@gmail.com>
---
 econet_eth.c         | 10 ++++++++--
 econet_eth.h         |  1 +
 econet_port.c        | 10 ++++++++++
 econet_ppe_offload.c | 17 +++++++++++++++++
 4 files changed, 36 insertions(+), 2 deletions(-)

diff --git a/econet_eth.c b/econet_eth.c
index a474328..717e7d6 100644
--- a/econet_eth.c
+++ b/econet_eth.c
@@ -48,6 +48,10 @@
 #include "qdma_regs.h"
 #include "econet_eth.h"
 
+static bool en75_ppe = true;
+module_param(en75_ppe, bool, 0444);
+MODULE_PARM_DESC(en75_ppe, "Use the PPE for hardware flow offload");
+
 /* MT7530 switch configuration */
 #define  PMCR_FORCE_FDX			BIT(1)
 #define  PMCR_FORCE_LNK			BIT(0)
@@ -150,7 +154,8 @@ static struct net_device *en75_get_sport_dev(struct en75_eth_pvt *eth,
 	if (sport == ETX_FPORT_GDM2) {
 		return eth->ports[1];
 	} else {
-		if (sport != ETX_FPORT_GDM1)
+		/* with the GDM special tag on, 8 + switch port = GDM1 */
+		if (sport != ETX_FPORT_GDM1 && !(en75_hw_stag && sport >= 8))
 			dev_info(eth->pub.dev, "rx: on unexpected fport %d\n", sport);
 		return eth->ports[0];
 	}
@@ -423,7 +428,8 @@ static int en75_probe(struct platform_device *pdev)
 	/* The PPE is optional: if it cannot be brought up (e.g. the FOE
 	 * table allocation fails) carry on without hardware offload rather
 	 * than failing the whole device. */
-	eth->ppe = en75_ppe_init(&pdev->dev, eth->regs->ppe, eth->regs->fe);
+	eth->ppe = en75_ppe ? en75_ppe_init(&pdev->dev, eth->regs->ppe,
+					   eth->regs->fe) : ERR_PTR(-ENODEV);
 	if (IS_ERR(eth->ppe)) {
 		dev_warn(&pdev->dev, "PPE init failed (%pe), offload disabled\n",
 			 eth->ppe);
diff --git a/econet_eth.h b/econet_eth.h
index 95a55d7..f277b61 100644
--- a/econet_eth.h
+++ b/econet_eth.h
@@ -168,6 +168,7 @@ struct en75_eth {
 };
 
 /* Called in softirq context */
+extern bool en75_hw_stag;
 int en75_rx_before_recv(struct en75_eth *eth, struct sk_buff *skb,
 			enum etx_fport sport);
 
diff --git a/econet_port.c b/econet_port.c
index 801490b..069ffa5 100644
--- a/econet_port.c
+++ b/econet_port.c
@@ -20,6 +20,12 @@
 #include "gdm_regs.h"
 #include "qdma_desc.h"
 
+/* GDM special tag mode (stag_en), as the vendor driver configures it on
+ * EN7528: the MTK tag stays inline in both directions, the PPE parses it
+ * and the RX descriptor reports the source as 8 + switch port. */
+bool en75_hw_stag = true;
+module_param(en75_hw_stag, bool, 0444);
+
 struct en75_hw_stats {
 	/* protect concurrent hw_stats accesses */
 	spinlock_t lock;
@@ -190,6 +196,10 @@ static int en75_dev_open(struct net_device *dev)
 		u32 __iomem *vreg = (u32 __iomem *)&port->regs->vlan;
 
 		writel(readl(vreg) | BIT(0), vreg);
+		if (en75_hw_stag)
+			writel(1, &port->regs->stag_en);
+		netdev_info(dev, "special tag: vlan %08x stag_en %08x\n",
+			    readl(vreg), readl(&port->regs->stag_en));
 	}
 
 	/* TX-done completions are reported with ~3 ms latency. BQL reacts
diff --git a/econet_ppe_offload.c b/econet_ppe_offload.c
index e529a3b..f24b699 100644
--- a/econet_ppe_offload.c
+++ b/econet_ppe_offload.c
@@ -235,6 +235,22 @@ en75_flow_tuple_from_skb(struct en75_flow_tuple *t, struct sk_buff *skb,
 static void
 en75_flow_offload_mangle_eth(const struct flow_action_entry *act, void *eth)
 {
+#ifndef CONFIG_CPU_BIG_ENDIAN
+	/* Little-endian (EN7528): the encoding matches the CPU, so the
+	 * upstream mtk_flow_offload_mangle_eth() byte copy is right. */
+	void *dest = eth + act->mangle.offset;
+	const void *src = &act->mangle.val;
+
+	if (act->mangle.offset > 8)
+		return;
+
+	if (act->mangle.mask == 0xffff) {
+		src += 2;
+		dest += 2;
+	}
+
+	memcpy(dest, src, act->mangle.mask ? 2 : 4);
+#else
 	const u8 *vb = (const u8 *)&act->mangle.val;	/* native (BE) bytes */
 	u8 *e = (u8 *)eth;
 
@@ -258,6 +274,7 @@ en75_flow_offload_mangle_eth(const struct flow_action_entry *act, void *eth)
 		WARN_ON_ONCE(1);
 		break;
 	}
+#endif
 }
 
