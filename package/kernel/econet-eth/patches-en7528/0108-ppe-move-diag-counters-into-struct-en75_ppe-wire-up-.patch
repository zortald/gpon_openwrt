From 88f54e357167c75b5308369d4e390f94b2554d79 Mon Sep 17 00:00:00 2001
From: Emre Yavuzalp <emreyavuzalp2@gmail.com>
Date: Sat, 10 Oct 2026 12:21:08 +0300
Subject: [PATCH 108/116] ppe: move diag counters into struct en75_ppe, wire up
 crsn histogram

en75_diag[]/en75_diag_crsn[] were bare file-scope globals even though
every caller already had a struct en75_ppe * in scope and the debugfs
file already carries ppe as its private data - no reason for the
global. Moved both arrays into the struct.

While touching this: en75_diag_crsn[] was declared and displayed by
debugfs but never incremented anywhere, so the "crsn histogram" was
dead. Wired it up at the one RX call site that already decodes crsn.

Verified: out-of-tree build clean against both en751221 (BE) and
en7528 (LE) target kernels.
---
 econet_ppe.h         |  6 +++---
 econet_ppe_offload.c | 48 +++++++++++++++++++++-----------------------
 econet_qdma.c        | 12 +++++++++--
 3 files changed, 36 insertions(+), 30 deletions(-)

diff --git a/econet_ppe.h b/econet_ppe.h
index 1418272..1ae2a2d 100644
--- a/econet_ppe.h
+++ b/econet_ppe.h
@@ -171,9 +171,6 @@ enum en75_diag_id {
 	EN75_DIAG_REPL_REJ_PORTS,
 	EN75_DIAG_COUNT,
 };
-extern u32 en75_diag[EN75_DIAG_COUNT];
-extern u32 en75_diag_crsn[32];
-
 struct en75_ppe {
 	struct device		*dev;
 	/* GDM1's netdev: the only egress the FOE can forward to. */
@@ -196,6 +193,9 @@ struct en75_ppe {
 	/* tuple -> en75_flow_entry map, drives the RX-hint commit. */
 	struct rhashtable	tuple_table;
 	bool			tuple_table_ready;
+	/* debugfs "diag" counters (en75_diag_show). */
+	u32			diag[EN75_DIAG_COUNT];
+	u32			diag_crsn[32];
 };
 
