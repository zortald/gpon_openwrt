diff --git a/econet_qdma.c b/econet_qdma.c
index 72c5263..00a87db 100644
--- a/econet_qdma.c
+++ b/econet_qdma.c
@@ -1,4 +1,5 @@
 // SPDX-License-Identifier: GPL-2.0-only
+#include <linux/err.h>
 #include <linux/spinlock.h>
 #include <linux/hrtimer.h>
 #include <linux/netdevice.h>
@@ -177,9 +178,11 @@ static void en75_qdma_rx_process_one(struct en75_q_rx *q, u32 cpu_i,
 	struct en75_q_rx_ent *e = &q->entry[cpu_i];
