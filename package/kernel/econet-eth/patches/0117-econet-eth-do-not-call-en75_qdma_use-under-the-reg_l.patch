From 47feeda394a4ad4b46ed8fac35d68ddb581ab77f Mon Sep 17 00:00:00 2001
From: Sergey <onufriev.serg@gmail.com>
Date: Fri, 13 Nov 2026 21:04:52 +0000
Subject: [PATCH] econet-eth: do not call en75_qdma_use() under the reg_lock
 spinlock

en75_dev_open() took port->reg_lock with guard(), which holds it until
the function returns, so en75_qdma_use() ran under the spinlock. It
takes qdma->lock (a mutex) and calls napi_enable(), both of which may
sleep. On an SMP EN751221 (2 VPEs) with CONFIG_DEBUG_ATOMIC_SLEEP this
reports "BUG: sleeping function called from invalid context" on every
interface open.

Limit the spinlock to the rx_len_threshold read-modify-write.
---
 econet_port.c | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/econet_port.c b/econet_port.c
index 069ffa5..5c93492 100644
--- a/econet_port.c
+++ b/econet_port.c
@@ -224,12 +224,15 @@ static int en75_dev_open(struct net_device *dev)
 	// 	airoha_fe_clear(qdma->eth, REG_GDM_INGRESS_CFG(port->id),
 	// 			GDM_STAG_EN_MASK);
 
-	guard(spinlock)(&port->reg_lock);
-	rlt = en75_rreg(&port->regs->rx_len_threshold);
-	set_gdm_len_th_runt_len(&rlt, 60);
-	set_gdm_len_th_oversize_len(&rlt, ETH_HLEN + dev->mtu + ETH_FCS_LEN);
-	en75_wreg(rlt, &port->regs->rx_len_threshold);
+	scoped_guard(spinlock, &port->reg_lock) {
+		rlt = en75_rreg(&port->regs->rx_len_threshold);
+		set_gdm_len_th_runt_len(&rlt, 60);
+		set_gdm_len_th_oversize_len(&rlt, ETH_HLEN + dev->mtu + ETH_FCS_LEN);
+		en75_wreg(rlt, &port->regs->rx_len_threshold);
+	}
 
+	/* en75_qdma_use() takes qdma->lock (a mutex) and enables NAPI, which
+	 * may sleep: it must not run under the reg_lock spinlock. */
 	return en75_qdma_use(port->qdma);
 }
 
-- 
