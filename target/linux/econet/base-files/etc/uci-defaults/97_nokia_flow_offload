#!/bin/sh
# Nokia G-1426-MA / G-140W-C: offload routed/NATed flows to the PPE (hardware NAT in
# econet-eth). Flows to Wi-Fi stay in the software flowtable.
. /lib/functions.sh

case "$(board_name)" in
nokia,g1426ma|nokia,g140w-c) ;;
*) exit 0 ;;
esac

uci -q set firewall.@defaults[0].flow_offloading=1
uci -q set firewall.@defaults[0].flow_offloading_hw=1
uci commit firewall
exit 0
