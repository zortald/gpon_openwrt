#!/bin/sh
# Nokia G-1426-MA: offload routed/NATed flows to the PPE (hardware NAT in
# econet-eth). Flows to Wi-Fi stay in the software flowtable.
. /lib/functions.sh

[ "$(board_name)" = nokia,g1426ma ] || exit 0

uci -q set firewall.@defaults[0].flow_offloading=1
uci -q set firewall.@defaults[0].flow_offloading_hw=1
uci commit firewall
exit 0
