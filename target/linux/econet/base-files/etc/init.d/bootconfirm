#!/bin/sh /etc/rc.common
# Confirm a good boot to the dual-image bootloader, like the stock firmware
# does. The bootloader clears "startok" on every boot and falls back to the
# other image when boots are not confirmed.
START=99

le32() {
	printf "$(printf "\\\\%03o\\\\%03o\\\\%03o\\\\%03o" $(($1 & 255)) $(($1 >> 8 & 255)) $(($1 >> 16 & 255)) $(($1 >> 24 & 255)))"
}

rd32() {
	hexdump -s "$2" -n 4 -e "1/4 \"%u\"" "$1"
}

# Installed from the stock web upgrade, the image header CRC also covers the
# UBI after the kernel, which changes as soon as it is attached. Switch it to
# the kernel-only CRC that the image builder stored at 0xa8, as sysupgrade
# images have it, or the bootloader would reject the image on the next boot.
g1426_fix_header() {
	local dev blk=/tmp/bootconfirm.hdr kcrc

	dev="$(find_mtd_part kernel | sed s/block//)"
	[ -n "$dev" ] && [ "$(rd32 $dev 84)" != 0 ] || return 0
	kcrc=$(rd32 $dev 168)
	[ "$kcrc" != 0 ] || return 0
	dd if=$dev of=$blk bs=131072 count=1 2>/dev/null
	{ le32 $((0x400000)); le32 $kcrc; } | dd of=$blk bs=1 seek=8 conv=notrunc 2>/dev/null
	le32 0 | dd of=$blk bs=1 seek=84 conv=notrunc 2>/dev/null
	mtd -q write $blk kernel && logger -t bootconfirm "image header switched to kernel-only CRC"
	rm -f $blk
}

boot() {
	local want cur dev

	case "$(board_name)" in
	nokia,g1425)
		# only when running from bank B (rootfs_slave)
		grep -q '"rootfs_slave"' /proc/mtd || return 0
		# u32 BE: active=1 (bank B), curimg=1, startok=1, count=14
		want="0000000100000001000000010000000e"
		dev="$(find_mtd_part flag | sed s/block//)"
		cur=$(hexdump -v -n 16 -e "16/1 \"%02x\"" "$dev" 2>/dev/null)
		[ "$cur" = "$want" ] && return 0
		printf "\0\0\0\001\0\0\0\001\0\0\0\001\0\0\0\016" > /tmp/bootconfirm.flag
		;;
	nokia,g1426ma)
		g1426_fix_header
		# u32 LE: active=0 (bank A), curimg=0, startok=1, count=14
		want="0000000000000000010000000e000000"
		dev="$(find_mtd_part flag | sed s/block//)"
		cur=$(hexdump -v -n 16 -e "16/1 \"%02x\"" "$dev" 2>/dev/null)
		[ "$cur" = "$want" ] && return 0
		printf "\0\0\0\0\0\0\0\0\001\0\0\0\016\0\0\0" > /tmp/bootconfirm.flag
		;;
	*)
		return 0
		;;
	esac

	mtd -q write /tmp/bootconfirm.flag flag && logger -t bootconfirm "flag confirmed (was $cur)"
	rm -f /tmp/bootconfirm.flag
}
