. /lib/functions/system.sh
. /lib/functions/uci-defaults.sh
. /lib/functions/econet.sh

econet_setup_interfaces()
{
	local board="$1"

	case "$board" in
	nokia,g1425)
		ucidef_set_interfaces_lan_wan "lan2 lan3 lan4" "wan"
		ucidef_set_interface "lan" ipaddr "10.100.0.1" netmask "255.255.255.0"
		ucidef_set_country "UA"
		ucidef_set_wireless all "G1425" "none"
		;;
	tplink,archer-vr1200v-v2)
		ucidef_set_interface_lan "lan1 lan2 lan3 lan4"
		ucidef_set_interface_wan "wan"
		;;
	*)
		ucidef_set_interface_lan "lan1 lan2 lan3 lan4"
		;;
	esac
}

econet_setup_macs()
{
	local board="$1"
	local lan_mac=""
	local wan_mac=""
	local label_mac=""

	case "$board" in
	chinamobile,gs3101)
		wan_mac="$(get_mac_gs3101)"
		[ -n "$wan_mac" ] && lan_mac="$(macaddr_add $wan_mac 1)"
		;;
	nokia,g1425)
		# WAN carries the factory MAC (ri@0x3e), LAN takes the one below it
		wan_mac="$(mtd_get_mac_binary ri 0x3e)"
		[ -n "$wan_mac" ] && lan_mac="$(macaddr_add $wan_mac -1)"
		label_mac=$wan_mac
		;;
	huawei,hg2821t-u)
		local conffile="/tmp/configuration_a/factory.conf"
		lan_mac=$(get_mac_ascii "$conffile" brmac)
		wan_mac=$(get_mac_ascii "$conffile" internetmac)
		label_mac=$wan_mac
		;;
	esac

	[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" "$lan_mac"
	[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" "$wan_mac"
	[ -n "$label_mac" ] && ucidef_set_label_macaddr "$label_mac"
}

board_config_update
board=$(board_name)
econet_setup_interfaces $board
econet_setup_macs $board
board_config_flush

exit 0
