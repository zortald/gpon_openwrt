# Nokia G-140W-C: mac80211 copies the subframes of every received A-MSDU, which
# took 27 % of the single CPU at 300 Mbit/s of Wi-Fi upload. Tell stations not
# to put A-MSDUs into A-MPDUs (mt76 patch 102); upload 273-278 -> 318-326 Mbit/s.
# Written after mount_root, before the Wi-Fi drivers load.

g140wc_wifi_amsdu() {
	local f=/etc/modules.d/mt76-rx-amsdu

	[ "$(board_name)" = nokia,g140w-c ] || return 0
	[ -e $f ] && return 0	# keep a value set by hand
	echo "mt76 mt76_rx_amsdu_in_ampdu=0" > $f
}

boot_hook_add preinit_main g140wc_wifi_amsdu
